# Copy to .env and fill in
DATABASE_URL="file:./data/dev.db"
APP_PASSWORD="change-me-to-a-strong-password"
SESSION_SECRET="generate-a-long-random-string-at-least-32-chars"
OPENAI_API_KEY="sk-..."
# Where uploaded expense + generated invoice PDFs live (mounted volume in prod)
UPLOAD_DIR="./uploads"
# Optional: import Stripe sales invoices, credit notes and fees into the books.
# Use a *restricted* live key with read access to Invoices, Credit notes,
# Customers, Tax rates and Balance transactions.
STRIPE_SECRET_KEY=""
# Minutes between automatic syncs (default 60)
STRIPE_SYNC_INTERVAL_MIN="60"
# Test-mode keys are refused unless this is "true" (only on a throwaway DB)
STRIPE_ALLOW_TEST_DATA="false"
