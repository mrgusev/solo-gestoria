// Solo Gestoría — Spanish autónomo bookkeeping
// Single-tenant SQLite schema. Money stored as integer cents to avoid float drift.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

// Singleton (id = 1). Stores issuer/company info, defaults, deduction rules.
model Settings {
  id                       Int       @id @default(1)
  // Issuer identity
  issuerName               String
  issuerTaxId              String // NIF / DNI / NIE — Spanish tax ID
  issuerVatId              String // VAT ID with country prefix, e.g. "ES" + NIF
  issuerAddressLine        String
  issuerPostalCode         String
  issuerCity               String
  issuerProvince           String
  issuerCountry            String
  issuerEmail              String?
  issuerPhone              String? // contact phone; digits only, used for AEAT 349 "persona con quién relacionarse"
  // Legacy single-account bank details. Superseded by the BankAccount table —
  // kept as the bootstrap source (seed.ts turns them into the first
  // BankAccount row) and as a last-resort fallback for a DB that somehow has
  // no accounts at all. Nothing writes them any more; edit accounts under
  // /settings/bank-accounts instead.
  bankName                 String
  bankIban                 String
  bankSwift                String
  bankAddress              String?
  // Defaults
  defaultHourlyRateCents   Int       @default(9200) // €92.00
  defaultLineDescription   String    @default("Solution Architect Software Development")
  vatExemptionFootnote     String    @default("Invoice exempt from VAT pursuant to Directive 2006/112/EC and art. 25 of VAT Law 37/1992.")
  // Default tax rates for domestic (Spanish) invoices. Stored as fractions to
  // match InvoiceLine.vatRate. 21% IVA general, 15% retención IRPF for
  // actividades profesionales (7% applies during the first 3 years of activity).
  defaultVatRate           Float     @default(0.21)
  defaultIrpfRetentionRate Float     @default(0.15)
  irpfRetentionNote        String    @default("Retención de IRPF practicada conforme al art. 101.5 de la Ley 35/2006 del IRPF y al art. 95 del Reglamento del IRPF.")
  homeOfficePct            Int       @default(30) // % of home's m² declared to Hacienda for the activity (Grado de afectación on modelo 036)
  homeOfficeStartDate      DateTime? // date the alta of the local-affecto took effect (modelo 036 alta date) — expenses before this date are not eligible for home-office deductions
  retaMonthlyCuotaCents    Int       @default(0) // €0 until user sets it
  // Invoice numbering: next sequence to use within the current year
  invoiceNumberYear        Int       @default(2026)
  invoiceNumberSeq         Int       @default(1)
  // Default client used when an invoice is created without an explicit clientId.
  // Set this to the id of the Client you bill most often (or your only client).
  defaultClientId          String?
  // Telegram bot
  telegramBotToken         String? // from @BotFather
  telegramAllowedChatIds   String? // comma-separated chat IDs allowed to talk to the bot
  // Outbound SMTP, used to email invoices to clients. Empty host disables
  // sending entirely (the recurring cron then only DMs the PDF to Telegram).
  // For Gmail: smtp.gmail.com:587, user = the full address, password = a
  // 16-char App Password (2-Step Verification must be on).
  smtpHost                 String?
  smtpPort                 Int       @default(587)
  smtpSecure               Boolean   @default(false) // true only for implicit TLS on port 465
  smtpUser                 String?
  smtpPassword             String?
  // "PASSWORD" (App Password / plain SMTP auth) or "OAUTH2" (Sign in with
  // Google — XOAUTH2 against smtp.gmail.com). OAuth2 ignores smtpPassword and
  // uses the google* fields below instead.
  smtpAuthType             String    @default("PASSWORD")
  googleClientId           String?
  googleClientSecret       String?
  googleRefreshToken       String? // long-lived; obtained once via the consent flow
  googleRedirectUri        String? // must match the Cloud Console entry exactly
  smtpFromName             String? // display name on the From header
  smtpFromEmail            String? // must be the authenticated address or a verified alias
  smtpReplyTo              String?
  smtpBccSelf              Boolean   @default(true) // blind-copy the From address on every invoice email
  // UI accent palette. Name of a preset from src/lib/palettes.ts. Drives the
  // --accent-* CSS variables via a runtime <style> tag in the root layout.
  accentPalette            String    @default("coral")
  updatedAt                DateTime  @updatedAt
}

// Idempotency record for the scheduled deadline reminders. The pair
// (kind, refKey) uniquely identifies one reminder, e.g.
// ("filing_t7", "2026-Q2") — so we never DM the user twice about the same
// thing even across worker restarts.
model SentReminder {
  id     String   @id @default(cuid())
  kind   String
  refKey String
  sentAt DateTime @default(now())

  @@unique([kind, refKey])
}

// Per-chat conversation state with the LLM agent. We use OpenAI Responses
// API's `previous_response_id` to maintain context across turns — only the
// last id needs to be persisted.
model AgentConversation {
  id             String   @id @default(cuid())
  chatId         String   @unique
  lastResponseId String?
  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
}

// How sales to a client are treated for IVA. Drives which MOD 303 boxes an
// invoice lands in, whether it appears in MOD 349, and whether IRPF is
// withheld.
enum VatTreatment {
  DOMESTIC_ES // Spanish client — IVA repercutido + retención IRPF
  INTRA_EU_REVERSE_CHARGE // EU business — exempt (art. 25), MOD 303 [59] + MOD 349
  EXPORT_NON_EU // outside the EU — exempt, never in MOD 349
}

model Client {
  id                String             @id @default(cuid())
  name              String
  taxId             String? // local registration / Reg no. — NIF/CIF for Spanish clients
  vatId             String? // VAT ID (e.g. EE102500628)
  countryCode       String // ISO 2-letter, e.g. EE, ES
  addressLine       String
  postalCode        String
  city              String
  province          String? // required on Spanish addresses, unused elsewhere
  country           String // human-readable country name
  email             String?
  notes             String?
  // Tax treatment. Rates are fractions (0.21, 0.15) like InvoiceLine.vatRate.
  // Used as defaults when creating an invoice; the invoice snapshots them.
  vatTreatment      VatTreatment       @default(INTRA_EU_REVERSE_CHARGE)
  defaultVatRate    Float              @default(0)
  irpfRetentionRate Float              @default(0)
  invoiceLocale     String             @default("en") // "en" | "es" — picks the PDF template
  invoices          Invoice[]
  recurring         RecurringInvoice[]
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

// A destination clients pay into. There can be several — a Spanish IBAN for
// domestic clients, another bank for the rest — and every invoice points at
// the one whose details its PDF prints.
//
// Which account an invoice gets is decided once, at issue time, and stored on
// the invoice: re-pointing a default later must not rewrite the payment
// details of an invoice that has already gone out.
model BankAccount {
  id                   String             @id @default(cuid())
  label                String // short name for the pickers, e.g. "Revolut ES"
  beneficiary          String? // account holder, when it differs from issuerName
  bankName             String
  iban                 String
  swift                String
  address              String? // bank's postal address, printed under the IBAN
  notes                String? // free line on the PDF, e.g. "Correspondent BIC: CHASDEFX"
  // Comma-separated VatTreatment values this account is the default for, e.g.
  // "DOMESTIC_ES". Outranks isDefault, loses to an explicit pick on the invoice.
  defaultForTreatments String?
  // Fallback for invoices no treatment rule matched. At most one row carries it.
  isDefault            Boolean            @default(false)
  // The account AEAT refunds into / direct-debits from (modelo 303 / 130).
  useForAeat           Boolean            @default(false)
  // Hidden from the pickers without breaking the invoices that reference it.
  archived             Boolean            @default(false)
  invoices             Invoice[]
  recurring            RecurringInvoice[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model Invoice {
  id            String         @id @default(cuid())
  number        String         @unique // e.g. FACT-2025-00001
  date          DateTime // invoice date
  dueDate       DateTime
  client        Client         @relation(fields: [clientId], references: [id])
  clientId      String
  subtotalCents Int // sum of line netCents (base imponible)
  vatCents      Int // total VAT (IVA repercutido)
  irpfCents     Int            @default(0) // retención IRPF withheld by the client
  totalCents    Int // subtotal + vat - irpf (what the client pays)
  currency      String         @default("EUR")
  vatExempt     Boolean        @default(true)
  exemptionNote String? // override default
  // Tax treatment snapshotted at issue time so later edits to the Client never
  // rewrite already-filed history.
  vatTreatment  VatTreatment   @default(INTRA_EU_REVERSE_CHARGE)
  irpfRate      Float          @default(0) // fraction, e.g. 0.15
  locale        String         @default("en") // "en" | "es" — PDF template
  notes         String?
  // Where this invoice asks to be paid. Resolved from the client's treatment
  // (or an explicit pick) when the invoice is issued, then left alone. Null on
  // invoices issued before multi-account support — those fall back to the
  // legacy Settings.bank* details, which is exactly what their PDF printed.
  bankAccount   BankAccount?   @relation(fields: [bankAccountId], references: [id])
  bankAccountId String?
  pdfPath       String? // path under uploads/invoices/
  // Manual early lock — once set, the invoice is immutable in the UI/tools.
  // Auto-lock by MOD 303 filing deadline is computed at read-time in
  // src/lib/invoice-lock.ts, no field needed for that.
  lockedAt      DateTime?
  // Email delivery record — set once the PDF has actually gone out to the
  // client, whether from the recurring cron or the button on the invoice page.
  emailedAt     DateTime?
  emailedTo     String? // recipient list actually used
  lines         InvoiceLine[]
  recurringRuns RecurringRun[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([date])
}

model InvoiceLine {
  id             String  @id @default(cuid())
  invoice        Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId      String
  position       Int // 1-based order within invoice
  description    String
  quantity       Float // hours
  unit           String  @default("h")
  unitPriceCents Int
  vatRate        Float   @default(0) // 0.0 - 0.21
  netCents       Int // quantity * unitPrice (rounded)
}

enum RecurringFrequency {
  MONTHLY
  QUARTERLY
  YEARLY
}

// A standing instruction to bill a client on a schedule. Nothing here is an
// invoice — the cron turns a due occurrence into a RecurringRun, and only an
// explicit confirmation creates the numbered Invoice. That ordering keeps the
// FACT-YYYY-NNNNN sequence gapless (art. 6.1.a RD 1619/2012), which it wouldn't
// be if we issued upfront and deleted on skip.
model RecurringInvoice {
  id         String             @id @default(cuid())
  name       String // label for the UI, e.g. "Acme monthly retainer"
  client     Client             @relation(fields: [clientId], references: [id])
  clientId   String
  active     Boolean            @default(true)
  frequency  RecurringFrequency @default(MONTHLY)
  // Issue day within the target month. Clamped to the month's length, so 31
  // still fires on Feb 28/29.
  dayOfMonth Int                @default(1)
  dueDays    Int                @default(15) // dueDate = issue date + this
  startDate  DateTime // first occurrence's month/year anchor
  endDate    DateTime? // no occurrence is generated after this
  // Invoice template. Lines are a JSON array of InvoiceLineInput — same shape
  // the web editor and the bot already build.
  linesJson  String
  vatRate    Float? // null = inherit the client's treatment
  irpfRate   Float?
  notes      String?
  // Payment destination for the invoices this schedule issues. Null resolves
  // the same way a manual invoice does — by the client's tax treatment.
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])
  bankAccountId String?
  // Recipients. Null emailTo falls back to Client.email at send time.
  emailTo    String?
  emailCc    String?
  runs       RecurringRun[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([active])
}

enum RecurringRunStatus {
  PENDING_CONFIRMATION // cron fired, waiting on the Telegram button
  SENT // invoice issued and emailed
  ISSUED // invoice issued but the email didn't go out
  SKIPPED // user declined this occurrence
  FAILED // generation itself blew up
}

// One row per (schedule, period). Doubles as the cron's idempotency record —
// the unique constraint means a restart or a second hourly tick can't bill the
// same month twice.
model RecurringRun {
  id                 String             @id @default(cuid())
  recurring          RecurringInvoice   @relation(fields: [recurringInvoiceId], references: [id], onDelete: Cascade)
  recurringInvoiceId String
  periodKey          String // "2026-08" — the occurrence this covers
  dueOn              DateTime // the occurrence's issue date
  status             RecurringRunStatus @default(PENDING_CONFIRMATION)
  invoice            Invoice?           @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  invoiceId          String?
  error              String?
  // Where the confirmation prompt was posted, so the callback can edit it.
  chatId             String?
  messageId          Int?
  resolvedAt         DateTime?
  createdAt          DateTime           @default(now())

  @@unique([recurringInvoiceId, periodKey])
  @@index([status])
}

// Expense categories drive default deductibility.
enum ExpenseCategory {
  UTILITY_ELECTRICITY
  UTILITY_INTERNET
  UTILITY_WATER
  UTILITY_GAS
  RENT_HOUSING // monthly rent — deductible at home-office area % for IRPF (no 30% multiplier)
  SOCIAL_SECURITY
  GESTORIA
  SOFTWARE
  BANK_FEES
  OTHER_DEDUCTIBLE
  NON_DEDUCTIBLE
}

enum ExpenseStatus {
  PENDING_REVIEW
  CONFIRMED
}

enum ExpenseSource {
  UPLOAD
  AUTO_RETA
  MANUAL
}

model Expense {
  id                 String          @id @default(cuid())
  date               DateTime // invoice date on the expense doc
  vendor             String
  vendorVatId        String?
  category           ExpenseCategory
  // Amounts
  grossCents         Int // total paid
  netCents           Int // base before VAT
  vatRate            Float           @default(0)
  vatCents           Int             @default(0)
  // Deduction
  deductiblePct      Float // 0..100; applied to both net and VAT (can be fractional, e.g. 6.3 = 30% × 21% area)
  deductibleNetCents Int
  deductibleVatCents Int
  // Provenance
  pdfPath            String?
  parsedJson         String? // raw OpenAI extraction (JSON string)
  status             ExpenseStatus   @default(PENDING_REVIEW)
  source             ExpenseSource   @default(UPLOAD)
  currency           String          @default("EUR")
  notes              String?
  // Helps idempotency for auto-RETA: one per (year,month) when source = AUTO_RETA
  retaYearMonth      String?         @unique // e.g. "2026-05" only set for AUTO_RETA rows
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([date])
  @@index([category])
}
